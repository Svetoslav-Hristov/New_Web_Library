@model CategoryFormModel
@{

    Layout = "_ForumLayout";



    bool isEdit = Model.Id > 0;

    string title = isEdit ? "Edit" : "Create";

    string formatAction = isEdit ? "EditCategory" : "CreateCategory";

}


<h2>@title Category</h2>

<form asp-controller="Categories" asp-action="@formatAction" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">@title</button>
    <a asp-area="" asp-controller="Categories" asp-action="Index" class="btn btn-primary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}