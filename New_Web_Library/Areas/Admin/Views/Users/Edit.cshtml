@model UserFormModel

@{

}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <form id="profile-form" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.FirstName" class="form-control" placeholder="Please choose your FirstName." />
                    <label asp-for="@Model.FirstName" class="form-label"></label>
                    <span asp-validation-for="@Model.FirstName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.LastName" class="form-control" placeholder="Please choose your lastName." />
                    <label asp-for="@Model.LastName" class="form-label"></label>
                    <span asp-validation-for="@Model.LastName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.UserName" class="form-control" placeholder="Please choose your username." readonly />
                    <label asp-for="@Model.UserName" class="form-label"></label>
                    <span asp-validation-for="@Model.UserName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.Age" class="form-control" placeholder="Please choose your age." />
                    <label asp-for="@Model.Age" class="form-label"></label>
                    <span asp-validation-for="@Model.Age" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.Address" class="form-control" placeholder="Please choose your address." />
                    <label asp-for="@Model.Address" class="form-label"></label>
                    <span asp-validation-for="@Model.Address" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                    <label asp-for="@Model.PhoneNumber" class="form-label"></label>
                    <span asp-validation-for="@Model.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="@Model.Email" class="form-control" placeholder="Please enter your phone number." />
                    <label asp-for="@Model.Email" class="form-label"></label>
                    <span asp-validation-for="@Model.Email" class="text-danger"></span>
                </div>

                <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary ">Save</button>
                <a href="javascript:history.back()" class="w-100 mt-1 btn btn-lg btn-secondary" >
                Cancel    
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}