@model UserViewModel

@{
    ViewData["Title"] = "User Details";

    var errorUser = TempData["ErrorUser"] as string;

    var successChanges = TempData["SuccessUser"] as string;
   
}


@if (!string.IsNullOrEmpty(errorUser))
{
    <div class="alert alert-danger" role="alert">
        @errorUser
    </div>

}

@if (!string.IsNullOrEmpty(successChanges))
{
    <div class="alert alert-success" role="alert">
        @successChanges
    </div>
}



<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <a asp-controller="Users"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm px-4 d-inline-flex align-items-center justify-content-center">
            Users List
        </a>
        <a asp-area="Admin"
            asp-controller="Systems"
           asp-action="Register"
           class="btn btn-outline-primary btn-sm px-4 d-inline-flex align-items-center justify-content-center">
           🧾 Loan Register
        </a>

        <div class="d-flex gap-2">
            <form asp-controller="Users"
                  asp-action="ChangeStatus"
                  asp-route-id="@Model.Id"
                  method="post" class="d-inline"
                  onsubmit="return confirm('Are you sure you want to change staus of this user?');">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger btn-sm px-4 d-inline-flex align-items-center justify-content-center">
                    ChangeStatus
                </button>
            </form>
            <a asp-area="Admin"
                asp-controller="Users"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-warning btn-sm px-4 d-inline-flex align-items-center justify-content-center">
                Edit
            </a>

            <form asp-controller="Users"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger btn-sm px-4 d-inline-flex align-items-center justify-content-center">
                    Delete
                </button>
            </form>
        </div>
    </div>


    <h2>User Profile</h2>

    <ul class="list-group mb-4">
        <li class="list-group-item"><strong>First Name:</strong> @Model.FirstName</li>
        <li class="list-group-item"><strong>Last Name:</strong> @Model.LastName</li>
        <li class="list-group-item"><strong>Age:</strong> @Model.Age</li>
        <li class="list-group-item"><strong>Address:</strong> @Model.Address</li>
        <li class="list-group-item"><strong>Phone:</strong> @Model.PhoneNumber</li>
        <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
        @if (Model.IsBlocked)
        {
            <li class="list-group-item"><strong>Status:</strong><span class="red-value">  Blocked !</span></li>
        }
        else
        {
            <li class="list-group-item"><strong>Status:</strong> <span class="green-value">  Not Blocked</span></li>


        }
    </ul>

    <h3>Books History</h3>

    @if (!Model.UserHistory.Any())
    {
        <p class="text-muted">No borrowed books.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Borrowed On</th>
                    <th>Returned On</th>

                </tr>
            </thead>
            <tbody>
                @foreach (UserBookHistoryModel b in Model.UserHistory)
                {
                    <tr>
                        <td>
                            <a asp-area=""
                                asp-controller="Books"
                               asp-action="Details"
                               asp-route-id="@b.BookId">
                                @b.Title
                            </a>
                        </td>
                        <td>@(b.PickUpDate?.ToShortDateString() ?? "-")</td>
                        <td>@(b.ReturnDate?.ToShortDateString() ?? "-")</td>

                    </tr>
                }
            </tbody>
        </table>
    }


</div>