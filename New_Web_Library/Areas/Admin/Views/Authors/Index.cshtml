@model IEnumerable<AuthorsListViewModel>


<div class="d-flex flex-grow-1">


    <!-- LEFT SIDEBAR -->
    <aside class="border-end bg-light p-3" style="width: 230px; flex-shrink: 0;">
        <h5 class="mb-3">Menu</h5>

        <div class="d-flex flex-column gap-2">
            <a asp-area="Admin"
               asp-controller="Authors"
               asp-action="Index"
               class="btn btn-outline-primary">
                All Authors
            </a>

            <a class="btn btn-outline-success"
               asp-area="Admin"
               asp-controller="Authors"
               asp-action="Create">
                ✏ + Add Author
            </a>
            <a class="btn btn-outline-success"
               asp-area="Admin"
               asp-controller="Users"
               asp-action="Index">
                🙎‍ Users Register
            </a>
            <a asp-area="Admin"
               asp-controller="Systems"
               asp-action="Register"
               class="btn btn-outline-primary">
                🧾 Loan Register
            </a>

            <a asp-area=""
               asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-primary">
                📚 Books Catalog
            </a>
        </div>
    </aside>
    <div class="col-md-9 col-lg-10 d-flex flex-column " style="min-height: 500px;">
        <!-- RIGHT CONTENT -->
        <div class="container flex-grow-1 d-flex flex-column">
            <main class="flex-grow-1 d-flex flex-column ">
                <!-- SEARCH -->
                <form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
                    <input type="text"
                           name="search"
                           value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="Search by FirstName or LastName or Age" />

                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>
                </form>

                <!-- HEADER -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-2">Author List</h1>

                </div>

                <!-- TABLE -->
                @if (!Model.Any())
                {
                    <p class="text-muted">No authors yet.</p>
                }
                else
                {
                    <div class="d-flex flex-column flex-grow-1">
                        <div class="flex-grow-1 overflow-auto">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="table-light">
                                        <th style="width: 250px;">Name</th>
                                        <th style="width: 180px;">Biography</th>
                                        <th style="width: 100px;">Image</th>
                                        <th style="width: 100px;">Info</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (AuthorsListViewModel u in Model)
                                    {
                                        <tr>
                                            <td>@u.Name</td>

                                            @if (u.Biography == null)
                                            {
                                                <td style="color:#FF0000">No</td>
                                            }
                                            else
                                            {

                                                <td style="color:#00FF00">Yes</td>
                                            }

                                            @if (u.ImageUrl == null)
                                            {
                                                <td style="color:#FF0000">No</td>
                                            }
                                            else
                                            {

                                                <td style="color:#00FF00">Yes</td>
                                            }
                                            <td>
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-area=""
                                                   asp-controller="Authors"
                                                   asp-action="Details"
                                                   asp-route-id=@u.Id>
                                                    AuthorInfo
                                                </a>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                }
            </main>
        </div>

    </div>

</div>
