@model AuthorPreviewDetails

@{

    var successAuthor = TempData["SuccessAuthor"] as string;

    var errorAuthor = TempData["ErrorAuthor"] as string;

}
@if (!string.IsNullOrEmpty(successAuthor))
{
    <div class="alert alert-success" role="alert">
        @successAuthor
    </div>

}
@if (!string.IsNullOrEmpty(errorAuthor))
{
    <div class="alert alert-danger" role="alert">
        @errorAuthor
    </div>

}


<div class="container mt-4">

    <h2 class="mb-3">@Model.Name</h2>

    <div class="author-biography">

        <img src="@(Model.ImageUrl ?? "/AuthorImages/default.jpg")"
             alt="@Model.Name"
             class="author-image" />

        <p>@Model.Biography</p>

    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2 mt-4">

            <a asp-area="Admin"
               asp-controller="Authors"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-warning">
                Edit
            </a>

            <form asp-area="Admin"
                  asp-controller="Authors"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this author?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Delete
                </button>
            </form>
            <a asp-area="Admin"
               asp-controller="Authors"
               asp-action="Index"
               class="btn btn-outline-primary">
                List Authors
            </a>

        </div>
    }
    else
    {
        <a asp-area=""
           asp-controller="Authors"
           asp-action="Index"
           class="btn btn-outline-primary">
            List Authors
        </a>

    }

</div>

@if (Model.Books != null && Model.Books.Any())
{
    <div class="mt-4 text-center text-black">
        <h3>Books from this Author</h3>
    </div>

    <div class="slider-wrapper gap-2 mt-4">

        <button onclick="scrollLeft()">←</button>

        <div class="book-slider" id="slider">
            @foreach (var book in Model.Books)
            {
                <a asp-controller="Books"
                   asp-action="Details"
                   asp-route-id="@book.Id"
                   class="book-card text-decoration-none text-dark">

                    <img src="/Images/@book.CoverImageUrl" />
                    <p>@book.Title</p>

                </a>
            }
        </div>

        <button onclick="scrollRight()">→</button>
    </div>
}
else
{
    <div class="mt-4 text-center text-muted">
        <p>No books available for this author yet.</p>
    </div>

}
@section Scripts {
    <script>
        function scrollLeft() {
            document.getElementById("slider").scrollBy({
                left: -300,
                behavior: "smooth"
            });
        }

        function scrollRight() {
            document.getElementById("slider").scrollBy({
                left: 300,
                behavior: "smooth"
            });
        }
    </script>

}
