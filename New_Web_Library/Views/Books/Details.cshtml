@model FullPreviewModelBook
@{
    ViewData["Title"] = "Book Details";

    var successBook = TempData["SuccessBook"] as string;

    var errorBook = TempData["ErrorBook"] as string;


    //reservation//

    var successReservation = TempData["SuccessReservation"] as string;




}


@if (!string.IsNullOrEmpty(errorBook))
{
    <div class="alert alert-danger" role="alert">
        @errorBook
    </div>

}

@if (!string.IsNullOrEmpty(successBook))
{
    <div class="alert alert-success" role="alert">
        @successBook
    </div>

}

@if (!string.IsNullOrEmpty(successReservation))
{
    <div class="alert alert-success" role="alert">
        @successReservation
    </div>

}
<div class="container">
    <h2 class="mb-4">Book Details</h2>



    <div class="container mt-4">
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="~/Images/@Model.CoverImageUrl"
                     alt="Book cover"
                     class="img-fluid rounded shadow" />
            </div>



            <div class="col-md-8">
                <h2>@Model.Title</h2>
                <h5 class="text-muted">by @Model.AuthorName</h5>
                <p>Year of published: @Model.YearOfPublished</p>
                <p>
                    Status:
                    @if (Model.BookStatus == BookStatus.Returned || Model.BookStatus == BookStatus.Expired)
                    {
                        <span style="color:lawngreen">Released</span>
                    }
                    else if (Model.BookStatus == BookStatus.PickedUp)
                    {
                        <span style="color:red;">@Model.BookStatus</span>
                    }
                    else
                    {
                        <span style="color:gold;">@Model.BookStatus</span>

                    }
                </p>
                <p>Genre: @Model.Genre</p>
                <hr />
                <p>@Model.Description</p>
            </div>
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-start ">
        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                <a asp-area="Admin"
                   asp-controller="Books"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-warning">
                    Edit
                </a>


                <form asp-area="Admin"
                      asp-controller="Books"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this book?');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-outline-danger">
                        Delete
                    </button>
                </form>

            </div>
        }
        <div class="d-flex  gap-2 ">
            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-success">
                BooksCatalog
            </a>

            @if ((Model.BookStatus == BookStatus.Returned || Model.BookStatus == BookStatus.Expired))
            {
                <form asp-controller="Systems"
                      asp-action="CreateReservation"
                      asp-route-bookId="@Model.Id"
                      method="post"
                      class="w-100">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-primary w-100">
                        Reserve
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-secondary disabled">
                    Not available
                </a>
            }
        </div>
    </div>

</div>

