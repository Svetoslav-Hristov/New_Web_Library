@model IEnumerable<IndexForumModel>

@{
    Layout = "_ForumLayout";


    //  category  //

    var successCategory = TempData["SuccessCategory"] as string;

    var errorCategory = TempData["ErrorCategory"] as string;


    // subcategory//

    var errorSubCategory = TempData["ErrorSubCategory"] as string;

    var successSubCategory = TempData["SuccessSubCategory"] as string;

    //comments//

    var errorComment = TempData["ErrorComment"] as string;



    // complaints message //
    var successMessage = TempData["SuccessMessage"] as string;

}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}


@if (!string.IsNullOrEmpty(errorCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorCategory
    </div>
}

@if (!string.IsNullOrEmpty(successSubCategory))
{
    <div class="alert alert-success" role="alert">
        @successSubCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorSubCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorSubCategory
    </div>
}



@if (!string.IsNullOrEmpty(successCategory))
{
    <div class="alert alert-success" role="alert">
        @successCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorCategory
    </div>
}





<div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-success"
           asp-area="Admin"
           asp-controller="Categories"
           asp-action="CreateCategory"
           style="background-color:lemonchiffon">
            + Add Category
        </a>
    }


    <table class="table">

        <thead style="background: lemonchiffon;">
            <tr>
                <th>Category</th>
                <th>Description</th>
                <th>Posts</th>
                <th>Last Post</th>
                <th>Last Active</th>
                <th></th>
                <th></th>
                <th></th>

            </tr>
        </thead>

        <tbody style="background-color:white">
            @foreach (var category in Model)
            {

                <tr>
                    <td>
                        <strong class="text-black fw-bolder fs-5">@category.Name</strong>

                        @if (category.Topics != null && category.Topics.Any())
                        {
                            <div style="margin-left:15px;">

                                <p>SubCategories</p>

                                @foreach (var sub in category.Topics)
                                {
                                    <div>
                                        <a asp-controller="Topics"
                                           asp-action="SubCategory"
                                           asp-route-id="@sub.Id"
                                           style="color: cornflowerblue; font-weight: bold; text-decoration-style: none;">

                                            @sub.Title
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                    </td>

                    <td>@category.Description</td>
                    <td>@category.PostCount</td>
                    <td>@category.LastPostTitle</td>
                    <td>@(category.LastActive.HasValue? category.LastActive.Value.ToLocalTime().ToString(ForumTimeFormat):"N/A") </td>






                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-outline-success"
                               asp-area="Admin"
                               asp-controller="Topics"
                               asp-action="CreateSubCategory"
                               asp-route-id="@category.Id">
                                + Add SubCategory
                            </a>
                        }
                    </td>

                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-outline-warning"
                               asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="EditCategory"
                               asp-route-id="@category.Id">
                                Edit Category
                            </a>
                        }
                    </td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-area="Admin"
                                  asp-controller="Categories"
                                  asp-action="DeleteCategory"
                                  asp-route-id="@category.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this category?');">

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    Delete Category
                                </button>
                            </form>
                        }
                    </td>
                </tr>


            }


        </tbody>
    </table>

</div>