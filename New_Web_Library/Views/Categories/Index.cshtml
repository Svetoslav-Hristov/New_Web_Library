@model IEnumerable<IndexForumModel>

@{
    Layout = "_ForumLayout";

    var errorMessage = TempData["WrongData"] as string;

    var errorCategory = TempData["ErrorCategory"] as string;

    var successCategory = TempData["SuccessCategory"] as string;

    var errorEdit = TempData["ErrorEdit"] as string;

    var errorSubCategory = TempData["ErrorSubCategory"] as string;

    var successSubCategory = TempData["SuccessSubCategory"] as string;

    var errorEditCategory = TempData["ErrorCategoryEdit"] as string;

    var errorEditSubCategory = TempData["ErrorEditSubCategory"] as string;

    var errorDeleteSubCategory = TempData["ErrorDeleteSubCategory"] as string;

}
@if (!string.IsNullOrEmpty(errorDeleteSubCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorDeleteSubCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorEditSubCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorEditSubCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorEditCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorEditCategory
    </div>
}

@if (!string.IsNullOrEmpty(successSubCategory))
{
    <div class="alert alert-success" role="alert">
        @successSubCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorSubCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorSubCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorEdit))
{
    <div class="alert alert-danger" role="alert">
        @errorEdit
    </div>
}



@if (!string.IsNullOrEmpty(successCategory))
{
    <div class="alert alert-success" role="alert">
        @successCategory
    </div>
}

@if (!string.IsNullOrEmpty(errorCategory))
{
    <div class="alert alert-danger" role="alert">
        @errorCategory
    </div>
}



@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}


<div>

    <a class="btn btn-outline-success"
       asp-controller="Categories"
       asp-action="CreateCategory">
        + Add Category
    </a>
    <table class="table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Description</th>
                <th>Posts</th>
                <th>Last Post</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        <strong>@category.Name</strong>

                        @if (category.Topics != null && category.Topics.Any())
                        {
                            <div style="margin-left:15px;">

                                <p>SubCategories</p>
                                @foreach (var sub in category.Topics)
                                {
                                    <div>
                                        <a asp-controller="Topics"
                                           asp-action="SubCategory"
                                           asp-route-id="@sub.Id"
                                           style="color: cornflowerblue; font-weight: bold; text-decoration-style: none;">
                                            
                                            @sub.Title
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                    </td>

                    <td>@category.Description</td>
                    <td>@category.PostCount</td>
                    <td>@category.LastPostTitle</td>
                    <td>
                        <a class="btn btn-outline-success"
                           asp-controller="Topics"
                           asp-action="CreateSubCategory"
                           asp-route-id="@category.Id">
                           + Add SubCategory
                        </a>
                    </td>

                    <td>
                        <a class="btn btn-outline-warning"
                           asp-controller="Categories"
                           asp-action="EditCategory"
                           asp-route-id="@category.Id">
                             Edit Category
                        </a>
                    </td>
                    <td>

                        <form asp-controller="Categories"
                              asp-action="DeleteCategory"
                              asp-route-id="@category.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this category?');">

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Delete Category
                            </button>
                        </form>

                    </td>
                </tr>

            }


        </tbody>
    </table>
</div>