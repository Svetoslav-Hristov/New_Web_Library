@model SubCategoryViewModel
@{
    Layout = "_ForumLayout";

    var errorEditPost = TempData["ErrorPost"] as string;

}

@if (!string.IsNullOrEmpty(errorEditPost))
{
    <div class="alert alert-danger" role="alert">
        @errorEditPost
    </div>
}

<div class="d-flex gap-2 mb-3">

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-outline-primary">
        Main Forum
    </a>

    <a asp-controller="Posts"
       asp-action="CreatePost"
       asp-route-Id="@Model.CategoryId"
       class="btn btn-outline-success">
        Add New Post
    </a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-area="Admin"
           asp-controller="Topics"
           asp-action="EditSubCategory"
           asp-route-id="@Model.CategoryId"
           class="btn btn-outline-warning">
            Edit SubCategory
        </a>
    }
    @if (User.IsInRole("Admin"))
    {
        <form asp-area="Admin"
              asp-controller="Topics"
              asp-action="DeleteSubCategory"
              asp-route-id="@Model.CategoryId"
              method="post"
              onsubmit="return confirm('Are you sure you want to delete this category?');">

            <button type="submit" class="btn btn-outline-danger">
                Delete Category
            </button>

        </form>
    }
</div>
<h3 class="category-title">@Model.CategoryName</h3>





<table class="table">

    <thead>
        <tr>
            <th>Post</th>
            <th>Author</th>
            <th>Created</th>
            <th>Comments</th>


        </tr>
    </thead>

    <tbody>
        @foreach (var post in Model.Posts)
        {

            <tr>
                <td>
                    @if (post.CommentCount > 0)
                    {
                        <span class="badge bg-primary">
                            Comments
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            No Comments
                        </span>

                    }

                    <a asp-controller="Posts"
                       asp-action="PostPreview"
                       asp-route-id="@post.Id"
                       style="color: cornflowerblue; font-weight: bold; text-decoration-style: none;">

                        @post.PostTitle
                    </a>
                </td>

                <td>@post.PostAuthor</td>
                <td>@post.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)</td>
                <td>@post.CommentCount</td>

            </tr>
        }
    </tbody>

</table>

