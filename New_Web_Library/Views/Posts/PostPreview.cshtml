@model PostForumPagingModel
@{



    Layout = "_ForumLayout";

    //comment//

    var errorComment = TempData["ErrorComment"] as string;

    var successComment = TempData["SuccessComment"] as string;

    //post//

    var errorDeletePost = TempData["ErrorPost"] as string;

    var successCreatePost = TempData["SuccessPost"] as string;

    //complaints//

    var errorCreateComplaints = TempData["Unexpected"] as string;

}

@if (!string.IsNullOrEmpty(errorCreateComplaints))
{
    <div class="alert alert-danger" role="alert">
        @errorCreateComplaints
    </div>
}





@if (!string.IsNullOrEmpty(errorDeletePost))
{
    <div class="alert alert-danger" role="alert">
        @errorDeletePost
    </div>
}


@if (!string.IsNullOrEmpty(successCreatePost))
{
    <div class="alert alert-success" role="alert">
        @successCreatePost
    </div>
}

@if (!string.IsNullOrEmpty(successComment))
{
    <div class="alert alert-success" role="alert">
        @successComment
    </div>
}



@if (!string.IsNullOrEmpty(errorComment))
{
    <div class="alert alert-danger" role="alert">
        @errorComment
    </div>
}


<div class="d-flex" style="max-height: 80vh;">


    <div class="border-end bg-light p-1" style="width: 230px; min-height: 85vh;">
        <div class="list-group">

            @if (User.IsInRole("User"))
            {
                <a asp-controller="Comments"
                   asp-action="CreateComment"
                   asp-route-Id="@Model.Post.Id"
                   class="btn btn-outline-success mb-3">
                    Add Comment
                </a>
            }

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-primary mb-3">
                MainForum
            </a>
            <a asp-controller="Topics"
               asp-action="SubCategory"
               asp-route-Id="@Model.Post.TopicId"
               class="btn btn-outline-warning mb-3">
                SubCategory
            </a>
            @if (User.IsInRole("User"))
            {
                <a asp-controller="Topics"
                   asp-action="CreateUserComplaint"
                   class="btn btn-outline-danger mb-3">
                    Contact Support
                </a>
            }
        </div>
    </div>

    <div class="container mt-4">

        <div class="card mb-3">
            <div class="row g-0">

                <!-- User info -->
                <div class="col-md-2 border-end p-2 text-center" style="background-color:lightgrey;">
                    <img src="~/images/default-user.png"
                         class="img-fluid rounded-circle mb-1"
                         style="width:60px;height:60px;" />

                    <div class="fw-bold small">@Model.Post.AuthorName</div>
                    <div class="text-muted small">Posts: @Model.Post.UserCommentCount</div>
                </div>

                <!-- Post content -->
                <div class="col-md-10 p-2" style="background-color: #e6f0ff;">
                    <h5 class="mb-1">@Model.Post.Title</h5>

                    <div class="text-muted small mb-2">
                        @Model.Post.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)
                    </div>

                    <div>
                        @Model.Post.Content
                    </div>
                </div>

            </div>
        </div>
        @if (Model.Post.IsAuthor)
        {
            <div class="d-flex gap-2">
                <a asp-action="EditPost" asp-route-id="@Model.Post.Id" class="btn btn-outline-warning mb-3">
                    Edit Post
                </a>
                <form asp-controller="Posts"
                      asp-action="DeletePost"
                      asp-route-id="@Model.Post.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this post?');">

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Delete
                    </button>
                </form>
            </div>
        }

        <div class="comments-section" style="min-height: 500px;">
            <h5>Comments (@Model.Comments.Count())</h5>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="card mb-2">
                        <div class="row g-0">

                            <!-- User info -->
                            <div class="col-md-2 border-end p-2 text-center" style="background-color:lightgrey;">
                                <img src="~/images/default-user.png"
                                     class="img-fluid rounded-circle mb-1"
                                     style="width:50px;height:50px;" />

                                <div class="fw-bold small">@comment.AuthorName</div>
                                <div class="text-muted small">Posts: @comment.UserPostCount</div>
                            </div>

                            <!-- Comment content -->
                            <div class="col-md-10 p-2">
                                <div class="fw-bold">@comment.Title</div>

                                <div class="text-muted small mb-1">
                                    @comment.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)
                                </div>

                                <div>
                                    @comment.Content
                                </div>

                                @if (comment.IsAuthor)
                                {
                                    <div class="mt-2 d-flex gap-2">
                                        <a asp-controller="Comments"
                                           asp-action="EditComment"
                                           asp-route-id="@comment.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Edit
                                        </a>

                                        <form asp-controller="Comments"
                                              asp-action="DeleteComment"
                                              asp-route-id="@comment.Id"
                                              asp-route-postId="@Model.Post.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this comment?');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No comments yet. Be the first to comment!</p>
            }
        </div>
        <div class="d-flex justify-content-between mt-3">

            @if (Model.CurrentPage > 1)
            {
                <a asp-action="PostPreview"
                   asp-route-id="@Model.Post.Id"
                   asp-route-pageNumber="@(Model.CurrentPage - 1)"
                   class="btn btn-outline-primary">
                    ← Previous
                </a>
            }
            else
            {
                <span></span>
            }

            <span>Page @Model.CurrentPage</span>

            @if ((Model.CurrentPage * Model.PageSize) < Model.TotalCommentsCount)
            @*<!-- pageSize -->*@
            {
                <a asp-action="PostPreview"
                   asp-route-id="@Model.Post.Id"
                   asp-route-pageNumber="@(Model.CurrentPage + 1)"
                   class="btn btn-outline-primary">
                    Next →
                </a>
            }

        </div>

    </div>
</div>