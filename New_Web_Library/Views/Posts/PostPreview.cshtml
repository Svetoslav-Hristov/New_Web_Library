@model PostForumModel
@{

    Layout = "_ForumLayout";

    var errorDeletePost = TempData["ErrorDeletePost"] as string;

    var errorComment = TempData["ErrorComment"] as string;

    var successEditComment = TempData["SuccessEditComment"] as string;

    var successCreatePost = TempData["SuccessPost"] as string;

    var errorDeleteComment = TempData["ErrorDeleteComment"] as string;

}


@if (!string.IsNullOrEmpty(errorDeleteComment))
{
    <div class="alert alert-danger" role="alert">
        @errorDeleteComment
    </div>
}



@if (!string.IsNullOrEmpty(errorDeletePost))
{
    <div class="alert alert-danger" role="alert">
        @errorDeletePost
    </div>
}


@if (!string.IsNullOrEmpty(successCreatePost))
{
    <div class="alert alert-success" role="alert">
        @successCreatePost
    </div>
}

@if (!string.IsNullOrEmpty(successEditComment))
{
    <div class="alert alert-success" role="alert">
        @successEditComment
    </div>
}



@if (!string.IsNullOrEmpty(errorComment))
{
    <div class="alert alert-danger" role="alert">
        @errorComment
    </div>
}



<div class="d-flex">

    <div class="border-end bg-light p-1" style="width: 230px; min-height: 100vh;">
        <div class="list-group">

            <a asp-controller="Comments"
               asp-action="CreateComment"
               asp-route-Id="@Model.Id"
               class="btn btn-outline-success mb-3">
                Add Comment
            </a>

            <a  asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-primary mb-3">
                MainForum
            </a>
            <a asp-controller="Topics"
               asp-action="SubCategory"
               asp-route-Id="@Model.TopicId"
               class="btn btn-outline-warning mb-3">
                SubCategory
            </a>
        </div>
    </div>

    <div class="container mt-4">

        <div class="card mb-3">
            <div class="row g-0">

                <!-- User info -->
                <div class="col-md-2 border-end p-2 text-center" style="background-color:lightgrey;">
                    <img src="~/images/default-user.png"
                         class="img-fluid rounded-circle mb-1"
                         style="width:60px;height:60px;" />

                    <div class="fw-bold small">@Model.AuthorName</div>
                    <div class="text-muted small">Posts: @Model.UserPostCount</div>
                </div>

                <!-- Post content -->
                <div class="col-md-10 p-2" style="background-color: #e6f0ff;">
                    <h5 class="mb-1">@Model.Title</h5>

                    <div class="text-muted small mb-2">
                        @Model.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)
                    </div>

                    <div>
                        @Model.Content
                    </div>
                </div>

            </div>
        </div>
        @if (Model.IsAuthor)
        {
            <div class="d-flex gap-2">
                <a asp-action="EditPost" asp-route-id="@Model.Id" class="btn btn-outline-warning mb-3">
                    Edit Post
                </a>
                <form asp-controller="Posts"
                      asp-action="DeletePost"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this post?');">
                 
                    <button type="submit"
                            class="btn btn-outline-danger">
                        Delete
                    </button>
                </form>
            </div>
        }

        <div class="comments-section">
            <h5>Comments (@Model.Comments.Count())</h5>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedOn))
                {
                    <div class="card mb-2">
                        <div class="row g-0">

                            <!-- User info -->
                            <div class="col-md-2 border-end p-2 text-center" style="background-color:lightgrey;">
                                <img src="~/images/default-user.png"
                                     class="img-fluid rounded-circle mb-1"
                                     style="width:50px;height:50px;" />

                                <div class="fw-bold small">@comment.AuthorName</div>
                                <div class="text-muted small">Posts: @comment.UserPostCount</div>
                            </div>

                            <!-- Comment content -->
                            <div class="col-md-10 p-2">
                                <div class="fw-bold">@comment.Title</div>

                                <div class="text-muted small mb-1">
                                    @comment.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)
                                </div>

                                <div>
                                    @comment.Content
                                </div>

                                @if (comment.IsAuthor)
                                {
                                    <div class="mt-2 d-flex gap-2">
                                        <a asp-controller="Comments"
                                           asp-action="EditComment"
                                           asp-route-id="@comment.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Edit
                                        </a>

                                        <form asp-controller="Comments"
                                              asp-action="DeleteComment"
                                              asp-route-id="@comment.Id"
                                              asp-route-postId="@Model.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this comment?');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No comments yet. Be the first to comment!</p>
            }
        </div>

    </div>
