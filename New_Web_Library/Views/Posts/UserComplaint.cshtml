@model ContentDetailsModel

@{
    Layout = "_ForumLayout";
}


<div class="container-fluid px-0">
    <div class="row">

        <!-- LEFT SIDEBAR -->
        <div class="col-auto border-end bg-light p-3" style="width: 180px; min-height: 100vh;">
            <h5 class="mb-3">Menu</h5>

            <div class="d-flex flex-column gap-2">
                <a asp-controller="Systems"
                   asp-action="ForumSupportPreview"
                   class="btn btn-outline-primary">
                    Delete Items
                </a>
            </div>
        </div>

        <!-- RIGHT CONTENT -->
        <div class="col" style=" max-width: 900px;">

            <div class="card mb-3">
                <div class="row g-0">

                    <!-- User info -->
                    <div class="col-md-2 border-end p-2 text-center" style="background-color:lightgrey;">
                        <img src="~/images/default-user.png"
                             class="img-fluid rounded-circle mb-1"
                             style="width:60px;height:60px;" />

                        <div class="fw-bold small">@Model.AuthorName</div>
                        <div class="text-muted small">Posts: @Model.UserCommentCount</div>
                    </div>

                    <!-- Post content -->
                    <div class="col-md-10 p-2" style="background-color: #e6f0ff;">
                        <h5 class="mb-1">@Model.Title</h5>

                        <div class="text-muted small mb-2">
                            @Model.CreatedOn.ToLocalTime().ToString(ForumTimeFormat)
                        </div>

                        <div>
                            @Model.Content
                        </div>
                    </div>

                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Systems" asp-action="UsersComplaints" class="btn btn-outline-warning mb-3">
                    Back
                </a>

                <form asp-controller="Posts"
                      asp-action="DeletePost"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this post?');">

                    <button type="submit" class="btn btn-outline-danger">
                        Mark as Read
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>

