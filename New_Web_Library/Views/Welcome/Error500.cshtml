@{
    ViewData["Title"] = "Server Error";
}

<div class="d-flex vh-100 justify-content-center align-items-center bg-dark text-white">
    <div class="text-center">
        <h1 class="display-1 fw-bold text-warning">500</h1>
        <h3 class="mb-3">Something went wrong 😢</h3>
        <p class="text-light">
            A system error has occurred. Please try again later.
        </p>

        <a href="javascript:history.back()" class="btn btn-outline-light mt-3">
            ⬅ Back
        </a>
    </div>
</div>